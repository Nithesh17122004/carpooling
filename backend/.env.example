# --- Server ---
SECRET_KEY=change-me-in-production
FLASK_ENV=development          # production in deployments
HOST=0.0.0.0
PORT=5000
PUBLIC_BASE_URL=
# Stun the refresh cookie for plain-HTTP development; MUST be true behind TLS.
REFRESH_COOKIE_SECURE=false
# >=1 enables werkzeug ProxyFix (trust X-Forwarded-*) -- keep 0 unless behind a
# fixed reverse proxy, so spoofed X-Forwarded-For cannot bypass rate limits.
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
# Client request-id header, sanitized before it enters logs.
REQUEST_ID_HEADER=X-Request-Id

# --- Auth / JWT ---
# 32+ random chars; rotate and invalidate all sessions when changed.
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=ridemate-api
COOKIE_NAME=rm_refresh
# 0 = allow logins without email verification (development only).
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_TTL_HOURS=24

# --- Google Sign-In (optional) ---
# Blank => POST /api/auth/google returns 503 google_not_configured. The server
# verifies the `credential` ID token against Google exactly; there is no bypass.
# NEVER put a real client id/secret in this file, in HTML, or in any tracked
# source: the browser fetches the public client id from
# GET /api/auth/providers. Set real values only in the git-ignored backend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MongoDB ---
# Comma-separatedMONGO_URI_FALLBACKS candidates. The app pings each in order
# and uses the first that answers, so cloud Atlas can be primary while a local
# mongod catches you when the network is unavailable.
#
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#   MONGO_URI_FALLBACKS=mongodb://localhost:27017
#
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ridemate
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# --- Rate limiting ---
# Redis is used when REDIS_URL is set; falls back to an in-process counter.
REDIS_URL=
RATE_LIMIT_DEFAULT=120          # requests per minute
RATE_LIMIT_AUTH=12              # login / register / google / password
RATE_LIMIT_STRICT=30            # booking mutations / refresh / payments

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5000,http://localhost:5500,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# --- Uploads ---
MAX_UPLOAD_MB=8
# local disk is the default; configure S3 to move uploads to object storage.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=

# --- Payments ---
# PAYMENT_PROVIDER=razorpay (production) or demo (local development only).
# The demo provider settles orders instantly with a synthetic signature and is
# hard-disabled when ENV=production. razorpay requires KEY_ID/KEY_SECRET plus a
# webhook secret (default path /api/payments/webhook).
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_PATH=/api/payments/webhook
# ------------- RAZORPAY -------------
# PLACEHOLDERS ONLY. Never commit a real key id, key secret or webhook secret
# to this file, to HTML, to source, to the README, to a Dockerfile or to a
# release ZIP -- the template ships to clients and ends up in Git history.
# Fetch keys from the Razorpay dashboard and put them in the git-ignored
# backend/.env (TEST keys: https://dashboard.razorpay.com/app/test/key).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signs payment.captured webhooks; from the account's webhook settings.
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX linked account that receives driver payouts.
RAZORPAY_X_ACCOUNT_NUMBER=
PAYOUT_ACCOUNT_ID=
# 'manual' means an admin records the bank reference after paying out of band.
# 'razorpayx' sends the transfer to Razorpay and settles only on their webhook.
PAYOUT_PROVIDER=manual
# Refuses any single payout above this amount rather than silently splitting it.
MAX_PAYOUT_AMOUNT=1000000

# --- Driver KYC ---
# When enabled, a vehicle must be verified before its owner can publish a ride.
# Leave this ON in production: 0 is only for local demo data.
KYC_ENFORCE_PUBLISH=1

# --- Booking / platform rules ---
# Commission is exactly 30% of the gross booking amount. The rate AND the rupee
# amount are frozen onto the payment document when the order is created, so a
# later config change can never rewrite a historical settlement.
# MIN_PLATFORM_FEE must stay 0: any non-zero floor makes low-fare bookings
# deviate from the exact 30% invariant and breaks reconciliation.
PLATFORM_FEE_PERCENT=30
MIN_PLATFORM_FEE=0
CANCELLATION_CUTOFF_MINUTES=60
# Unpaid orders (status pending_payment) are expired and their seats released.
PAYMENT_TTL_MINUTES=15
# Realtime location history retention (0 disables the TTL).
LOCATION_HISTORY_TTL_HOURS=168
RIDE_OVERLAP_BUFFER_MINUTES=30
SEATS_MAX_PER_BOOKING=12

# --- External providers (optional) ---
# Leave GOOGLE_MAPS_API_KEY blank to use OpenStreetMap (Nominatim + OSRM), which
# needs no account and is the default.
GOOGLE_MAPS_API_KEY=
OSM_USER_AGENT=ridemate/1.0
OUTBOUND_TIMEOUT_SECONDS=6

# --- Notifications ---
# Redis pub/sub wakes SSE streams; without Redis the in-process feed still works.
NOTIFY_REDIS_CHANNEL=ridemate:events